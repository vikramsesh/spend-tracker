rules_version = '2';

// Only the Google accounts listed here can read or change the shared spend book.
// Replace the two addresses, then paste this into Firebase console → Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['first.person@gmail.com', 'second.person@gmail.com'];
    }

    // Statements, settings, investment values and the house sheet copy
    match /books/shared/docs/{id} {
      allow read, write: if isMember();
    }
    match /books/shared/meta/{id} {
      allow read, write: if isMember();
    }

    // Change history: anyone in the book can add an entry under their own email;
    // nobody can edit or delete past entries.
    match /books/shared/log/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
